{
  "name": "gainly",
  "private": true,
  "scripts": {
    "build": "dotenv -e .env.local -- turbo run build",
    "dev": "dotenv -e .env.local -- turbo run dev",
    "dev:mobile": "dotenv -e .env.local -- turbo run dev --filter=mobile",
    "dev:web": "dotenv -e .env.local -- turbo run dev --filter=web",
    "dev:admin": "dotenv -e .env.local -- turbo run dev --filter=admin",
    "dev:api": "dotenv -e .env.local -- turbo run dev --filter=api",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:migrate": "supabase migration up",
    "db:seed": "supabase db reset",
    "exercises:import": "node scripts/import-workout-guide.ts"
  },
  "devDependencies": {
    "dotenv-cli": "11.0.0",
    "prettier": "3.9.6",
    "turbo": "^2.10.12",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=24"
  }
}
