# Gainly environment (spec §73). Copy to .env.local and fill in.
# NEVER commit real credentials. Server-only secrets must not be exposed to clients.

# --- Supabase ---
# SUPABASE_URL + SUPABASE_ANON_KEY: safe to expose to clients (mobile/web), the anon key is
# subject to RLS. SUPABASE_SERVICE_ROLE_KEY: server-only (apps/api), bypasses RLS entirely —
# never ship it in a mobile/web bundle (rls.md §Model, testing.md §4.5 CI grep gate).
# Local dev values come from `supabase status` after `supabase start` — see
# docs/scaffold-handover.md "Supabase" section for the local-dev loop.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# --- Stripe (server only) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Analytics / Observability ---
POSTHOG_KEY=
SENTRY_DSN=

# --- AI (server only) ---
AI_API_KEY=
