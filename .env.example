# Gainly environment (spec §73). Copy to .env.local and fill in — never commit real values.
# Every var below is named EXACTLY as packages/validation/src/env.ts (the Zod contract) and
# apps/mobile + apps/web + apps/admin expect. Do not rename without updating env.ts too.
#
# CLIENT-SAFE = fine inside a mobile/web bundle (protected by RLS, not by secrecy).
# SERVER-ONLY = apps/api ONLY. Bypasses RLS or is otherwise a real secret — never bundle it.

# --- Supabase (hosted project) --------------------------------------------------------------

# CLIENT-SAFE. Server code (apps/api) reads these unprefixed names.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# CLIENT-SAFE mirrors — Expo only inlines EXPO_PUBLIC_* into the mobile bundle, Next only
# inlines NEXT_PUBLIC_* into web/admin bundles. Keep these equal to the two lines above.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER-ONLY. Bypasses ALL RLS (rls.md §Model). Never import into apps/mobile or apps/web —
# testing.md §4.5 requires a CI grep gate proving this string never reaches a client bundle.
SUPABASE_SERVICE_ROLE_KEY=
# SERVER-ONLY. Migrations/pgTAP need the SESSION pooler (:5432), not transaction (:6543) —
# transaction mode doesn't support DDL/prepared statements and fails intermittently.
SUPABASE_DB_URL=

# --- Stripe (SERVER-ONLY) ---------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Analytics / Observability (SERVER-ONLY) --------------------------------------------------
POSTHOG_KEY=
SENTRY_DSN=

# --- AI (SERVER-ONLY) ---------------------------------------------------------------------------
AI_API_KEY=
