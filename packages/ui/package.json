{
  "name": "@gainly/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*": [
      "./src/*.ts",
      "./src/*.tsx"
    ]
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
